[Unit]
Description=AVON AI Chromium Kiosk Display for Raspberry Pi 3
After=graphical.target network-online.target
Wants=graphical.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi
ExecStart=/bin/bash /home/pi/AvonAI-SecondPass/avon-ai/hardware/kiosk/kiosk.sh http://192.168.1.100:5173
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
